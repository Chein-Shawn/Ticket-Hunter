// ===== 03_Scheduler.gs =====
/**
 * Ticket hunter — quiet hours, due checks, quota guard, source health (pure functions).
 */

/** "01:00-07:00, 23:30-00:30" → [{start: 60, end: 420}, {start: 1410, end: 30}] (minutes of day). */
function parseQuietHours(s) {
  var out = [];
  parseList(s).forEach(function (part) {
    var m = toHalfWidth(part).match(/^(\d{1,2})(?::(\d{2}))?\s*[-~到至]\s*(\d{1,2})(?::(\d{2}))?$/);
    if (!m) return;
    var a = (+m[1]) * 60 + (+(m[2] || 0));
    var b = (+m[3]) * 60 + (+(m[4] || 0));
    if (a > 1440 || b > 1440 || a === b) return;
    out.push({ start: a % 1440, end: b % 1440 });
  });
  return out;
}

function isMinuteQuiet(minute, ranges) {
  for (var i = 0; i < ranges.length; i++) {
    var r = ranges[i];
    if (r.start < r.end ? (minute >= r.start && minute < r.end) : (minute >= r.start || minute < r.end)) return true;
  }
  return false;
}

function isQuiet(date, ranges) {
  return isMinuteQuiet(taipeiMinuteOfDay(date), ranges || []);
}

/** 從現在到今天 24:00（臺北）之間：總分鐘數、非靜音分鐘數。 */
function minutesLeftToday(date, ranges) {
  var now = taipeiMinuteOfDay(date);
  var total = 1440 - now;
  var active = 0;
  for (var m = now; m < 1440; m++) if (!isMinuteQuiet(m, ranges || [])) active++;
  return { total: total, active: active };
}

function isDue(lastRunMs, nowMs, intervalMinutes) {
  if (!lastRunMs) return true;
  // 留 15 秒寬限，避免觸發器時間抖動讓每分鐘檢查變成每兩分鐘。
  return nowMs - lastRunMs >= intervalMinutes * 60000 - 15000;
}

/**
 * 配額保護。Apps Script 每分鐘都會觸發一次（idle 也會耗時），
 * 只有「到期」時才真正抓資料（active，額外耗時）。
 *   需求 = 剩餘總分鐘 × idleMs + (剩餘非靜音分鐘 / 間隔) × (activeMs − idleMs) ≤ 剩餘預算
 * o: { configured, budgetMs, usedMs, idleMs, activeMs, minutesTotalLeft, minutesActiveLeft }
 */
function computeEffectiveInterval(o) {
  var configured = Math.max(1, o.configured || 1);
  if (!o.budgetMs) return { interval: configured, paused: false, throttled: false };
  var left = o.budgetMs - (o.usedMs || 0);
  if (left <= 0) return { interval: Infinity, paused: true, throttled: false };
  var idle = o.idleMs != null ? o.idleMs : 300;
  var active = o.activeMs != null ? o.activeMs : 2500;
  var extra = Math.max(0, active - idle);
  var forActive = left - (o.minutesTotalLeft || 0) * idle;
  if (forActive <= 0) return { interval: Infinity, paused: true, throttled: false };
  if (!o.minutesActiveLeft || !extra) return { interval: configured, paused: false, throttled: false };
  var need = Math.ceil(o.minutesActiveLeft * extra / forActive);
  var interval = Math.max(configured, need);
  return { interval: interval, paused: false, throttled: interval > configured };
}

/** 依當日用量更新統計。usage: {day, usedMs, runs, idleMs, idleRuns, activeMs, activeRuns} */
function addUsage(usage, dayKey, elapsedMs, wasActive) {
  var u = (usage && usage.day === dayKey) ? usage : { day: dayKey, usedMs: 0, runs: 0, idleMs: 0, idleRuns: 0, activeMs: 0, activeRuns: 0 };
  u.usedMs += elapsedMs;
  u.runs += 1;
  if (wasActive) { u.activeMs += elapsedMs; u.activeRuns += 1; } else { u.idleMs += elapsedMs; u.idleRuns += 1; }
  return u;
}

function usageAverages(usage, dayKey) {
  var u = (usage && usage.day === dayKey) ? usage : null;
  return {
    usedMs: u ? u.usedMs : 0,
    idleMs: u && u.idleRuns ? u.idleMs / u.idleRuns : null,
    activeMs: u && u.activeRuns ? u.activeMs / u.activeRuns : null
  };
}

/**
 * 來源健康狀態。回傳 event：'down'（剛達到門檻）、'recovered'（警告過後恢復）或 null。
 * h: {fails, alerted, lastOk, lastRun, lastError}
 */
function recordHealth(h, ok, threshold, message, nowMs) {
  h = h || { fails: 0, alerted: false };
  var event = null;
  h.lastRun = nowMs;
  if (ok) {
    if (h.alerted) event = 'recovered';
    h.fails = 0;
    h.alerted = false;
    h.lastOk = nowMs;
    h.lastError = '';
  } else {
    h.fails = (h.fails || 0) + 1;
    h.lastError = String(message || '');
    if (h.fails >= threshold && !h.alerted) {
      h.alerted = true;
      event = 'down';
    }
  }
  return { health: h, event: event };
}

// ===== 10_Ptt.gs =====
/**
 * Ticket hunter — PTT parsing (pure functions).
 * Atom feed: https://www.ptt.cc/atom/Drama-Ticket.xml （每則 content 只有內文前幾行）
 */

var PTT_ATOM_URL = 'https://www.ptt.cc/atom/Drama-Ticket.xml';

/** Atom XML → [{id, url, title, author, publishedMs, content}]（id 例如 "M.1794491104.A.4E8"）。 */
function parsePttAtom(xml) {
  var entries = [];
  var re = /<entry>([\s\S]*?)<\/entry>/g;
  var m;
  while ((m = re.exec(String(xml || '')))) {
    var e = m[1];
    var url = (e.match(/<link[^>]*href="([^"]+)"/) || [])[1] || (e.match(/<id>([^<]+)<\/id>/) || [])[1] || '';
    url = decodeHtmlEntities(url);
    var id = (url.match(/\/(M\.[^/]+?)\.html/) || [])[1] || url;
    var title = decodeHtmlEntities(((e.match(/<title>([\s\S]*?)<\/title>/) || [])[1] || '').trim());
    var author = decodeHtmlEntities(((e.match(/<name>([\s\S]*?)<\/name>/) || [])[1] || '').trim());
    var published = (e.match(/<published>([^<]+)<\/published>/) || [])[1] || (e.match(/<updated>([^<]+)<\/updated>/) || [])[1] || '';
    var contentRaw = (e.match(/<content[^>]*>([\s\S]*?)<\/content>/) || [])[1] || '';
    // content 是被跳脫過的 HTML（&lt;pre&gt;…），先解跳脫再去標籤，最後再解一次實體。
    var content = decodeHtmlEntities(stripTags(decodeHtmlEntities(contentRaw))).trim();
    var t = Date.parse(published);
    entries.push({ id: id, url: url, title: title, author: author, publishedMs: isFinite(t) ? t : null, content: content });
  }
  return entries;
}

/** PTT 文章頁 HTML → 內文純文字（去掉標頭、推文、簽名檔）。 */
function extractPttArticleText(html) {
  html = String(html || '');
  var start = html.indexOf('<div id="main-content"');
  if (start < 0) return '';
  var body = html.slice(start);
  // 內文到「※ 發信站」為止（之後是 IP 與推文）。
  var cut = body.search(/※ 發信站|<span class="f2">※ 發信站/);
  if (cut > 0) body = body.slice(0, cut);
  body = body
    .replace(/<div class="article-metaline[\s\S]*?<\/div>/g, '')
    .replace(/<div class="article-metaline-right[\s\S]*?<\/div>/g, '')
    .replace(/<div class="push">[\s\S]*?<\/div>/g, '')
    .replace(/<br\s*\/?>/gi, '\n');
  var text = decodeHtmlEntities(stripTags(body));
  // 去掉簽名檔分隔線 "--" 之後的內容
  var sig = text.lastIndexOf('\n--\n');
  if (sig > 0) text = text.slice(0, sig);
  return text.replace(/\r/g, '').replace(/\n{3,}/g, '\n\n').trim();
}

/** "[售票] 11/28 ..." → "售票"；沒有分類回傳 ''。 */
function pttTitleTag(title) {
  var m = String(title || '').match(/^\s*(?:Re:\s*|Fw:\s*)?\[([^\]]{1,8})\]/i);
  return m ? m[1].trim() : '';
}

// ===== 11_Nuxt.gs =====
/**
 * Ticket hunter — safe parser for Nuxt 2 "window.__NUXT__" state.
 *
 * OPENTIX 把頁面資料放在 window.__NUXT__=(function(a,b,…){ 指派…; return {…} }(值1,值2,…))。
 * 這裡「只解析資料、不執行程式碼」（不用 eval / new Function）：Apps Script 有 Gmail 權限，
 * 執行第三方網站的 JavaScript 等於把信箱交給它。支援的語法僅限 Nuxt 產生的資料：
 * 物件、陣列、字串、數字、true/false/null/undefined、void 0、!0、!1、Array(n)、參數名稱參照，
 * 以及函式內 `x.y=值;`、`x[0]=值;` 這類指派。遇到其他語法就丟出錯誤（視為來源失敗，不會亂猜）。
 */

function parseNuxtStateFromHtml(html) {
  html = String(html || '');
  var marker = 'window.__NUXT__=';
  var start = html.indexOf(marker);
  if (start < 0) throw new Error('NUXT state not found');
  var end = html.indexOf('</script>', start);
  if (end < 0) end = html.length;
  var src = html.slice(start + marker.length, end).trim().replace(/;\s*$/, '');
  return parseNuxtExpression(src);
}

function parseNuxtExpression(src) {
  var head = '(function(';
  if (src.indexOf(head) !== 0) return new NuxtLiteralParser(src, 0, {}).parseValue();

  var p = new NuxtLiteralParser(src, head.length, {});
  var params = p.readIdentifierList(')');
  p.skipWs();
  p.expect('{');
  var bodyStart = p.pos;
  var bodyEnd = p.findMatchingBrace(bodyStart - 1);

  var a = new NuxtLiteralParser(src, bodyEnd + 1, {});
  a.skipWs();
  a.expect('(');
  var args = a.readValueList(')');

  var env = {};
  params.forEach(function (name, i) { env[name] = args[i]; });

  var b = new NuxtLiteralParser(src, bodyStart, env);
  for (var guard = 0; guard < 100000; guard++) {
    b.skipWs();
    if (b.pos >= bodyEnd) throw new Error('NUXT: no return statement');
    if (b.startsWithWord('return')) {
      b.pos += 6;
      return b.parseValue();
    }
    b.parseAssignment();
    b.skipWs();
    if (b.peek() === ';' || b.peek() === ',') b.pos++;
  }
  throw new Error('NUXT: too many statements');
}

function NuxtLiteralParser(src, pos, env) {
  this.src = src;
  this.pos = pos || 0;
  this.env = env || {};
}

NuxtLiteralParser.prototype.peek = function () { return this.src.charAt(this.pos); };

NuxtLiteralParser.prototype.fail = function (msg) {
  throw new Error('NUXT parse error at ' + this.pos + ': ' + msg + ' near "' + this.src.slice(this.pos, this.pos + 30) + '"');
};

NuxtLiteralParser.prototype.skipWs = function () {
  var s = this.src;
  while (this.pos < s.length && /\s/.test(s.charAt(this.pos))) this.pos++;
};

NuxtLiteralParser.prototype.expect = function (ch) {
  this.skipWs();
  if (this.src.charAt(this.pos) !== ch) this.fail('expected "' + ch + '"');
  this.pos++;
};

NuxtLiteralParser.prototype.startsWithWord = function (w) {
  if (this.src.substr(this.pos, w.length) !== w) return false;
  var next = this.src.charAt(this.pos + w.length);
  return !/[\w$]/.test(next);
};

NuxtLiteralParser.prototype.readIdentifier = function () {
  this.skipWs();
  var m = /^[A-Za-z_$][\w$]*/.exec(this.src.slice(this.pos, this.pos + 64));
  if (!m) this.fail('identifier expected');
  this.pos += m[0].length;
  return m[0];
};

NuxtLiteralParser.prototype.readIdentifierList = function (close) {
  var out = [];
  this.skipWs();
  if (this.peek() === close) { this.pos++; return out; }
  for (;;) {
    out.push(this.readIdentifier());
    this.skipWs();
    var c = this.peek();
    this.pos++;
    if (c === close) return out;
    if (c !== ',') this.fail('"," or "' + close + '" expected');
  }
};

NuxtLiteralParser.prototype.readValueList = function (close) {
  var out = [];
  this.skipWs();
  if (this.peek() === close) { this.pos++; return out; }
  for (;;) {
    out.push(this.parseValue());
    this.skipWs();
    var c = this.peek();
    this.pos++;
    if (c === close) return out;
    if (c !== ',') this.fail('"," or "' + close + '" expected');
  }
};

/** 從 openIndex 的 "{" 找到對應的 "}"（略過字串內容）。 */
NuxtLiteralParser.prototype.findMatchingBrace = function (openIndex) {
  var s = this.src, depth = 0;
  for (var i = openIndex; i < s.length; i++) {
    var c = s.charAt(i);
    if (c === '"' || c === "'") {
      for (i++; i < s.length && s.charAt(i) !== c; i++) if (s.charAt(i) === '\\') i++;
    } else if (c === '{') depth++;
    else if (c === '}') {
      depth--;
      if (depth === 0) return i;
    }
  }
  this.fail('unbalanced braces');
};

NuxtLiteralParser.prototype.parseValue = function () {
  this.skipWs();
  var c = this.peek();
  if (c === '{') return this.parseObject();
  if (c === '[') return this.parseArray();
  if (c === '"' || c === "'") return this.parseString();
  if (c === '-' || c === '.' || (c >= '0' && c <= '9')) return this.parseNumber();
  if (c === '!') {
    this.pos++;
    var v = this.parseValue();
    return !v;
  }
  var id = this.readIdentifier();
  switch (id) {
    case 'true': return true;
    case 'false': return false;
    case 'null': return null;
    case 'undefined': return undefined;
    case 'NaN': return NaN;
    case 'Infinity': return Infinity;
    case 'void':
      this.parseValue();
      return undefined;
    case 'Array':
      this.expect('(');
      var n = this.parseValue();
      this.expect(')');
      if (typeof n !== 'number' || n < 0 || n > 100000) this.fail('bad Array length');
      return new Array(n);
  }
  if (Object.prototype.hasOwnProperty.call(this.env, id)) return this.env[id];
  this.fail('unknown identifier "' + id + '"');
};

NuxtLiteralParser.prototype.parseObject = function () {
  this.expect('{');
  var obj = {};
  for (;;) {
    this.skipWs();
    var c = this.peek();
    if (c === '}') { this.pos++; return obj; }
    var key;
    if (c === '"' || c === "'") key = this.parseString();
    else if (c >= '0' && c <= '9') key = String(this.parseNumber());
    else key = this.readIdentifier();
    this.expect(':');
    obj[key] = this.parseValue();
    this.skipWs();
    c = this.peek();
    if (c === ',') { this.pos++; continue; }
    if (c === '}') { this.pos++; return obj; }
    this.fail('"," or "}" expected in object');
  }
};

NuxtLiteralParser.prototype.parseArray = function () {
  this.expect('[');
  var arr = [];
  for (;;) {
    this.skipWs();
    var c = this.peek();
    if (c === ']') { this.pos++; return arr; }
    arr.push(this.parseValue());
    this.skipWs();
    c = this.peek();
    if (c === ',') { this.pos++; continue; }
    if (c === ']') { this.pos++; return arr; }
    this.fail('"," or "]" expected in array');
  }
};

NuxtLiteralParser.prototype.parseNumber = function () {
  var m = /^-?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/.exec(this.src.slice(this.pos, this.pos + 40));
  if (!m) this.fail('number expected');
  this.pos += m[0].length;
  return parseFloat(m[0]);
};

NuxtLiteralParser.prototype.parseString = function () {
  var s = this.src, q = s.charAt(this.pos), out = '';
  this.pos++;
  while (this.pos < s.length) {
    var c = s.charAt(this.pos++);
    if (c === q) return out;
    if (c !== '\\') { out += c; continue; }
    var e = s.charAt(this.pos++);
    switch (e) {
      case 'n': out += '\n'; break;
      case 'r': out += '\r'; break;
      case 't': out += '\t'; break;
      case 'b': out += '\b'; break;
      case 'f': out += '\f'; break;
      case 'v': out += '\v'; break;
      case '0': out += '\0'; break;
      case 'x':
        out += String.fromCharCode(parseInt(s.substr(this.pos, 2), 16));
        this.pos += 2;
        break;
      case 'u':
        if (s.charAt(this.pos) === '{') {
          var close = s.indexOf('}', this.pos);
          out += String.fromCodePoint(parseInt(s.slice(this.pos + 1, close), 16));
          this.pos = close + 1;
        } else {
          out += String.fromCharCode(parseInt(s.substr(this.pos, 4), 16));
          this.pos += 4;
        }
        break;
      case '\n': break; // line continuation
      default: out += e;
    }
  }
  this.fail('unterminated string');
};

/** `name(.prop|[index])+ = value` → 寫入 env 中的物件。 */
NuxtLiteralParser.prototype.parseAssignment = function () {
  var base = this.readIdentifier();
  if (!Object.prototype.hasOwnProperty.call(this.env, base)) this.fail('assignment to unknown "' + base + '"');
  var path = [];
  for (;;) {
    this.skipWs();
    var c = this.peek();
    if (c === '.') { this.pos++; path.push(this.readIdentifier()); }
    else if (c === '[') {
      this.pos++;
      var k = this.parseValue();
      this.expect(']');
      path.push(String(k));
    } else break;
  }
  this.expect('=');
  var value = this.parseValue();
  if (!path.length) { this.env[base] = value; return; }
  var obj = this.env[base];
  for (var i = 0; i < path.length - 1; i++) {
    if (obj == null) this.fail('assignment into undefined');
    obj = obj[path[i]];
  }
  if (obj == null || typeof obj !== 'object') this.fail('assignment target is not an object');
  obj[path[path.length - 1]] = value;
};

// ===== 12_Opentix.gs =====
/**
 * Ticket hunter — OPENTIX (pure functions).
 * 活動頁 https://www.opentix.life/event/<id> 的 __NUXT__ 內含每個場次與票區的 remainingQuantity。
 */

function isOpentixEventUrl(url) {
  return /^https?:\/\/(www\.)?opentix\.life\/event\/\d+/.test(String(url || '').trim());
}

/**
 * state（parseNuxtStateFromHtml 的結果）→
 * { title, sessions: [{sessionId, venue, startMs, remaining, zones: [{zoneId, name, price, remaining}]}] }
 */
function extractOpentixSessions(state) {
  var sessions = [];
  var title = '';
  var seenSession = {};

  function walk(o, depth) {
    if (!o || typeof o !== 'object' || depth > 40) return;
    if (!title && o.program && typeof o.program.name === 'string') title = o.program.name;
    if (o.venue && Array.isArray(o.events)) {
      var venueName = (o.venue && o.venue.name) || '';
      o.events.forEach(function (ev) {
        if (!ev || ev.id == null || seenSession[ev.id]) return;
        seenSession[ev.id] = true;
        var zones = [];
        var gs = ev.groupSections || {};
        Object.keys(gs).forEach(function (k) {
          (Array.isArray(gs[k]) ? gs[k] : []).forEach(function (sec) {
            if (!sec || sec.id == null) return;
            zones.push({
              zoneId: String(sec.id),
              name: String(sec.name == null ? '' : sec.name),
              price: typeof sec.price === 'number' ? sec.price : toNumber(sec.price, null),
              remaining: sec.quantity && typeof sec.quantity.remainingQuantity === 'number' ? sec.quantity.remainingQuantity : null,
              unlimited: !!(sec.quantity && sec.quantity.unlimited)
            });
          });
        });
        sessions.push({
          sessionId: String(ev.id),
          venue: venueName,
          startMs: typeof ev.startDateTime === 'number' ? ev.startDateTime * 1000 : null,
          remaining: ev.quantity && typeof ev.quantity.remainingQuantity === 'number' ? ev.quantity.remainingQuantity : null,
          zones: zones
        });
      });
      return;
    }
    if (Array.isArray(o)) { for (var i = 0; i < o.length; i++) walk(o[i], depth + 1); return; }
    for (var key in o) if (Object.prototype.hasOwnProperty.call(o, key)) walk(o[key], depth + 1);
  }

  walk(state, 0);
  sessions.sort(function (a, b) { return (a.startMs || 0) - (b.startMs || 0); });
  return { title: title, sessions: sessions };
}

function opentixSessionLabel(s) {
  return (s.startMs ? formatTaipei(new Date(s.startMs)) : '') + (s.venue ? ' ' + s.venue : '');
}

/** 輪椅席與輪椅陪同席預設不勾選（只有自備輪椅者可購買）。 */
function defaultZoneMonitored(zoneName) {
  return !/輪椅|wheelchair/i.test(String(zoneName || ''));
}

/**
 * 比對勾選的票區：剩餘張數 > 0 且（第一次看到或比上次多）就通知。
 * zoneRows: parseZoneRow 結果；prev: { "sessionId:zoneId": n }
 * 回傳 { hits: [...], current: {...} }（current 包含所有看到的票區，供下次比較）。
 */
function evaluateOpentixZones(parsed, zoneRows, prev, targetName) {
  prev = prev || {};
  var current = {};
  var hits = [];
  var monitored = {};
  (zoneRows || []).forEach(function (z) {
    if (z.monitor && z.zoneId && (!targetName || z.target === targetName)) monitored[z.sessionId + ':' + z.zoneId] = z;
  });
  parsed.sessions.forEach(function (s) {
    s.zones.forEach(function (z) {
      var key = s.sessionId + ':' + z.zoneId;
      if (z.remaining == null) return;
      current[key] = z.remaining;
      if (!monitored[key]) return;
      var before = prev[key];
      if (z.remaining > 0 && (before == null || z.remaining > before)) {
        hits.push({
          source: 'opentix',
          target: targetName || monitored[key].target,
          title: parsed.title,
          session: opentixSessionLabel(s),
          zone: z.name,
          price: z.price,
          remaining: z.remaining,
          previous: before == null ? null : before,
          key: key
        });
      }
    });
  });
  return { hits: hits, current: current };
}

// ===== 20_Matcher.gs =====
/**
 * Ticket hunter — post matching, price reading, rules (pure functions).
 *
 * 第一階段（尚無 AI）：關鍵字初篩 → 標題分類／已售 → 排除字與排除規則 → 日期 → 價格。
 * 看不出價格時預設仍通知並加註，寧可多報不可漏報。
 */

/** 找出關鍵字命中的目標。text 通常是「標題＋摘要」。 */
function findMatchingTargets(text, targets) {
  var norm = normalizeForMatch(text);
  return (targets || []).filter(function (tg) {
    if (!tg.enabled) return false;
    return tg.keywords.some(function (k) {
      var nk = normalizeForMatch(k);
      return nk && norm.indexOf(nk) >= 0;
    });
  });
}

/** 文中出現的「月/日」（11/28、11月28日、1/2）→ ["11/28", ...] */
function extractMonthDays(text) {
  var out = [];
  var seen = {};
  var re = /(^|[^\d\/.])(\d{1,2})\s*(?:\/|月)\s*(\d{1,2})(?=[^\d\/]|$)/g;
  var m;
  var s = toHalfWidth(text);
  while ((m = re.exec(s))) {
    var mo = +m[2], d = +m[3];
    if (mo >= 1 && mo <= 12 && d >= 1 && d <= 31) {
      var k = mo + '/' + d;
      if (!seen[k]) { seen[k] = true; out.push(k); }
    }
  }
  return out;
}

function normalizeMonthDay(s) {
  var m = toHalfWidth(String(s)).match(/(\d{1,2})\s*(?:\/|月|-)\s*(\d{1,2})/);
  return m ? (+m[1]) + '/' + (+m[2]) : null;
}

var TH_NUM = '(\\d{1,3}(?:,\\d{3})+|\\d{3,6})(?!\\d)';

function toPrice_(s) {
  var n = parseInt(String(s).replace(/,/g, ''), 10);
  return n >= 100 && n <= 200000 ? n : null;
}

/**
 * 從文字讀出原價與售價。
 * 回傳 {face, ask, atFace, below, surcharge, extras, titlePrice}
 */
function parsePrices(title, body) {
  var text = toHalfWidth(String(title || '') + '\n' + String(body || ''));
  var r = { face: null, ask: null, atFace: false, below: false, surcharge: false, extras: false, titlePrice: null };

  // 原價（若寫成 1350-1880 這類範圍，取最大值）
  var fm = new RegExp('(?:原價|票面(?:價)?|定價)\\s*[:：]?\\s*(?:每張|NT\\$?|\\$)?\\s*' + TH_NUM + '(?:\\s*[-~～]\\s*' + TH_NUM + ')?').exec(text);
  if (fm) {
    var f1 = toPrice_(fm[1]), f2 = fm[2] ? toPrice_(fm[2]) : null;
    r.face = f2 && f1 ? Math.max(f1, f2) : f1;
  }

  // 售價
  var am = new RegExp('(?:售價|讓價|價格|價錢|金額|降售|降讓|賠售|特價|只要|出售|售|讓)\\s*[:：]?\\s*(?:每張|NT\\$?|\\$)?\\s*' + TH_NUM).exec(text);
  if (am) r.ask = toPrice_(am[1]);

  // 「原價讓」「原讓」「原價售」「原價出」
  if (/原價(?:讓|售|出|轉)|原讓|原價釋出/.test(text)) r.atFace = true;
  if (/降售|降讓|降價|賠售|賠本|折售|打折/.test(text)) r.below = true;
  if (/\+\s*福利|含福利|加價/.test(text)) r.extras = true;

  // 標題 "4980+200" → 原價 4980、售價 5180
  var sm = new RegExp(TH_NUM + '\\s*\\+\\s*(\\d{2,5})(?!\\d)').exec(toHalfWidth(title || ''));
  if (sm) {
    var base = toPrice_(sm[1]), add = parseInt(sm[2], 10);
    if (base) {
      r.surcharge = true;
      if (r.face == null) r.face = base;
      if (r.ask == null) r.ask = base + add;
    }
  }

  // 標題 "1680*2"、"2800x1" 的單價
  var tm = new RegExp(TH_NUM + '\\s*[*xX×]\\s*\\d{1,2}(?!\\d)').exec(toHalfWidth(title || ''));
  if (tm) r.titlePrice = toPrice_(tm[1]);

  if (r.ask == null && r.atFace && r.face != null) r.ask = r.face;
  if (r.ask == null && r.titlePrice != null) r.ask = r.titlePrice;
  return r;
}

/**
 * 判斷一篇貼文對某個目標要不要通知。
 * post: {title, text, author, url}；target: parseTargetRow 結果；rules: parseRuleRow[]；settings: parseSettings 結果
 * 回傳 {notify, reason: {key, params}|null, flags: [], price}
 */
function evaluatePost(post, target, rules, settings) {
  var title = String(post.title || '');
  var text = String(post.text || '');
  var all = title + '\n' + text;
  var normAll = normalizeForMatch(all);
  var flags = [];

  var tag = pttTitleTag(title);
  if (tag) {
    for (var i = 0; i < settings.skipTags.length; i++) {
      if (tag.indexOf(settings.skipTags[i]) >= 0) return skip_('skip_tag', { tag: tag });
    }
  }
  if (/已售|售出|已出|已讓|已換|徵得|收到了/.test(title)) return skip_('skip_sold', {});

  for (var e = 0; e < target.excludes.length; e++) {
    var ne = normalizeForMatch(target.excludes[e]);
    if (ne && normAll.indexOf(ne) >= 0) return skip_('skip_exclude', { word: target.excludes[e] });
  }

  for (var r = 0; r < (rules || []).length; r++) {
    var rule = rules[r];
    if (!rule.enabled || !rule.words.length) continue;
    if (rule.target && rule.target !== target.name) continue;
    var allIn = rule.words.every(function (w) {
      var nw = normalizeForMatch(w);
      return nw && normAll.indexOf(nw) >= 0;
    });
    if (allIn) return skip_('skip_rule', { words: rule.words.join(' + ') });
  }

  if (target.dates.length) {
    var wanted = target.dates.map(normalizeMonthDay).filter(Boolean);
    var found = extractMonthDays(all);
    if (wanted.length && found.length && !found.some(function (d) { return wanted.indexOf(d) >= 0; })) {
      return skip_('skip_date', { dates: found.join(', ') });
    }
  }

  var price = parsePrices(title, text);
  var face = price.face;
  if (face == null && target.maxFace) {
    face = target.maxFace;
    if (price.ask != null) flags.push('flag_face_from_target');
  }
  if (price.surcharge) flags.push('flag_surcharge');
  if (price.extras) flags.push('flag_extras');

  if (price.ask != null && face != null) {
    var limit = settings.accept_above_face ? face * (1 + (settings.above_face_max_percent || 0) / 100) : face;
    if (price.ask > limit) return skip_('skip_above_face', { ask: price.ask, face: face });
    if (price.ask > face) flags.push('flag_above_face_allowed');
    else if (price.ask < face) flags.push('flag_below_face');
    else flags.push('flag_at_face');
  } else {
    if (price.atFace) flags.push('flag_at_face');
    else if (price.below) flags.push('flag_below_face');
    if (!price.atFace && !price.below) {
      if (!settings.notify_when_price_unknown) return skip_('skip_price_unknown', {});
      flags.push('flag_price_unknown');
    }
  }

  return { notify: true, reason: null, flags: flags, price: { face: face, ask: price.ask } };

  function skip_(key, params) {
    return { notify: false, reason: { key: key, params: params }, flags: flags, price: null };
  }
}

/** 同一賣家、同一標題（正規化後）的重貼鍵。 */
function repostKey(author, title) {
  var t = normalizeForMatch(String(title || '').replace(/^\s*\[[^\]]*\]/, ''));
  return String(author || '').toLowerCase() + '|' + t;
}

/** 清掉超過 hours 的紀錄；回傳新物件。 */
function pruneRepostMap(map, nowMs, hours) {
  var out = {};
  var limit = nowMs - hours * 3600000;
  Object.keys(map || {}).forEach(function (k) { if (map[k] >= limit) out[k] = map[k]; });
  return out;
}

/** 已讀清單：保留最後 max 筆。 */
function rememberSeen(list, ids, max) {
  var seen = {};
  var out = [];
  (list || []).concat(ids || []).forEach(function (id) {
    if (!seen[id]) { seen[id] = true; out.push(id); }
  });
  return out.slice(Math.max(0, out.length - (max || 400)));
}

