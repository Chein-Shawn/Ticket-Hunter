function t(lang, key, params) {
  var table = TH_STRINGS[lang] || TH_STRINGS['zh-TW'];
  var s = table[key];
  if (s == null) s = TH_STRINGS['zh-TW'][key];
  if (s == null) s = key;
  if (params) {
    s = s.replace(/\{(\w+)\}/g, function (m, k) { return params[k] != null ? String(params[k]) : m; });
  }
  return s;
}
